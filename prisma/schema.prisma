generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Workspace {
  id String @id @default(cuid())
  demo Boolean @default(false)
  createdAt DateTime @default(now())
  users User[]
  machines Machine[]
  announcements Announcement[]
}
model User {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email String
  name String
  room String
  passwordHash String
  role String @default("RESIDENT")
  specialty String?
  status String @default("PENDING")
  isDemo Boolean @default(false)
  createdAt DateTime @default(now())
  sessions Session[]
  bookings Booking[]
  requests MaintenanceRequest[] @relation("Author")
  assigned MaintenanceRequest[] @relation("Assignee")
  complaints Complaint[]
  notifications Notification[]
  attachments Attachment[]
  @@unique([workspaceId,email])
}
model Session {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}
model Machine {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  number Int
  active Boolean @default(true)
  bookings Booking[]
  @@unique([workspaceId,number])
}
model Booking {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  machineId String
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  durationMinutes Int
  status String @default("BOOKED")
  createdAt DateTime @default(now())
  @@index([startsAt,status])
}
model MaintenanceRequest {
  id String @id @default(cuid())
  authorId String
  author User @relation("Author", fields: [authorId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee User? @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  specialty String
  title String
  description String
  room String
  status String @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  history StatusEvent[]
  attachments Attachment[]
}
model Complaint {
  id String @id @default(cuid())
  authorId String
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title String
  description String
  status String @default("RECEIVED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  history StatusEvent[]
  attachments Attachment[]
}
model StatusEvent {
  id String @id @default(cuid())
  requestId String?
  request MaintenanceRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  complaintId String?
  complaint Complaint? @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  status String
  createdAt DateTime @default(now())
}
model Announcement {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title String
  body String
  category String
  pinned Boolean @default(false)
  startsAt DateTime @default(now())
  endsAt DateTime
  createdAt DateTime @default(now())
}
model Notification {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventKey String @unique
  title String
  body String
  href String
  read Boolean @default(false)
  createdAt DateTime @default(now())
}
model Attachment {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId String?
  request MaintenanceRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  complaintId String?
  complaint Complaint? @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  storageKey String
  mime String
  createdAt DateTime @default(now())
}
model RateLimit {
  key String @id
  attempts Int @default(1)
  expiresAt DateTime
}
